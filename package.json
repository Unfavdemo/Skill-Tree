{
  "name": "skill-tree",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NEXT_DISABLE_FILE_SYSTEM_CACHE=1 next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.2",
    "framer-motion": "^12.38.0",
    "isomorphic-dompurify": "^3.12.0",
    "lucide-react": "^0.544.0",
    "next": "^15.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "cross-env": "^10.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.3.2",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.13"
  }
}
