# Public env vars are exposed to the browser — never put secrets you must keep server-only here.
# Copy to `.env` locally. Vercel: Project Settings → Environment Variables.

# OpenAI (used by lesson/challenge generation in the browser in this demo — prefer a server API in production)
NEXT_PUBLIC_OPENAI_API_KEY=

# Next.js dev: disable filesystem cache (helps on Windows when `.next` cache files intermittently disappear/ENOENT)
NEXT_DISABLE_FILE_SYSTEM_CACHE=1

# Canonical site URL for metadata / Open Graph (optional; Vercel sets VERCEL_URL for previews)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
